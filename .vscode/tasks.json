{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AgriLink: Backend Server",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/server"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agrilink"
      }
    },
    {
      "label": "AgriLink: Frontend Client",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/client"
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "group": "agrilink"
      }
    },
    {
      "label": "🚀 Start AgriLink (Full Stack)",
      "dependsOn": [
        "AgriLink: Backend Server",
        "AgriLink: Frontend Client"
      ],
      "dependsOrder": "parallel",
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
